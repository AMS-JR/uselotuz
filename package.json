{
  "name": "uselotuz",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @uselotuz/web dev",
    "build": "pnpm --filter @uselotuz/web build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm --filter @uselotuz/web test:e2e"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.6",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
